{
  "server": {
    "allowPerRequestConfig": true,
    "allowPipes": false
  },
  "pipes": {
    "numClients": 1,
    "forkedJvmArgs": ["-Xmx2g"]
  },
  "parse-context": {
    "timeout-limits": {
      "totalTaskTimeoutMillis": 75000
    }
  },
  "engines": {
    "tesseract": {
      "tesseract-ocr-parser": {"skipOcr": false}
    }
  },
  "text-recognizers": [
    {"engine": "tesseract"}
  ],
  "parsers": [
    {"default-parser": {}},
    {"pdf-parser": {"ocr": {"strategy": "AUTO"}}}
  ]
}
